# Copy to .env in the repo root (never commit .env)

# Admin login (required)
ADMIN_PASSWORD=change-me
SECRET_KEY=generate-a-long-random-string

# GitHub (optional for local-only writes; required to push from admin)
GITHUB_TOKEN=
GITHUB_REPO=SwanyWu/meowoo
GITHUB_BRANCH=main

# Comma-separated sections allowed in the admin UI
PUBLISH_SECTIONS=ramble

# Set automatically on Render (secure session cookies). Optional locally:
# SESSION_HTTPS_ONLY=true
