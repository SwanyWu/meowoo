<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ meta_description }}" />
    <title>{{ post.title }} · {{ section_id }} · meowoo.me</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="{{ assets_prefix }}styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="{{ section.theme_class }}">
    <div class="glow" aria-hidden="true"></div>
    <header class="site-header">
      <a class="logo" href="{{ root_prefix }}index.html">meowoo.me</a>
      <nav class="site-nav" aria-label="Main">
        <a href="{{ root_prefix }}nom.html"{% if section.active_nav == 'nom' %} class="is-active" aria-current="page"{% endif %}>nom</a>
        <a href="{{ root_prefix }}stomp.html"{% if section.active_nav == 'stomp' %} class="is-active" aria-current="page"{% endif %}>stomp</a>
        <a href="{{ root_prefix }}ramble.html"{% if section.active_nav == 'ramble' %} class="is-active" aria-current="page"{% endif %}>ramble</a>
        <a href="{{ root_prefix }}looksie.html"{% if section.active_nav == 'looksie' %} class="is-active" aria-current="page"{% endif %}>looksie</a>
      </nav>
    </header>

    <main class="page {{ post.page_class }}">
      <article class="post">
        <header class="post-header">
          <p class="post-meta">
            <a class="post-meta__section" href="{{ section.post_footer_href }}">{{ section_id }}</a>
            <span class="post-meta__sep" aria-hidden="true">·</span>
            {% for tag in post.meta_tags %}
            <span>{{ tag }}</span>
            <span class="post-meta__sep" aria-hidden="true">·</span>
            {% endfor %}
            <time datetime="{{ post.date_iso }}">{{ post.date_display }}</time>
          </p>
          {% if post.post_vibe %}
          <p class="post-vibe">{{ post.post_vibe }}</p>
          {% endif %}
          <h1>{{ post.title }}</h1>
          {% if post.subtitle %}
          <p class="post-meta post-meta--sub">{{ post.subtitle | safe }}</p>
          {% endif %}
        </header>

        <div class="post-body">
          {{ post.body_html | safe }}
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <a href="{{ section.post_footer_href }}">{{ section.post_footer_label }}</a>
    </footer>
  </body>
</html>
